# =====================================================================
# Zycus AI Support Suite — Environment Configuration
# =====================================================================

# OpenAI API Key (Leave empty or offline for reproducible local evaluation)
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Model
OPENAI_MODEL=gpt-4o-mini

# Execution Mode: "auto", "llm", or "offline"
# - "auto": Uses OpenAI if OPENAI_API_KEY is valid, otherwise falls back to deterministic offline engine
# - "llm": Forces OpenAI structured JSON completion (fails if key is missing)
# - "offline": Forces local deterministic nearest-neighbor & evidence-driven offline engine (100% CI pass)
EXECUTION_MODE=auto

# Dynamic Reference Date Anchor Mode: "dataset_latest" or "current_time"
# - "dataset_latest": Dynamically anchors 90-day window to max(created_at) across loaded dataset (Recommended)
# - "current_time": Anchors to datetime.now(timezone.utc)
REFERENCE_DATE_MODE=dataset_latest

# Ticket History Window (Days)
TICKET_HISTORY_DAYS=90
